# Copia este archivo como .env y rellena tus datos reales.
# En hosting compartido con PHP, estas variables se configuran normalmente
# desde el panel de control (cPanel > PHP > Variables de entorno) o cargándolas
# con una línea al inicio de public/index.php si tu hosting no lo permite:
#   foreach (parse_ini_file(__DIR__.'/../.env') as $k => $v) putenv("$k=$v");

DB_HOST=127.0.0.1
DB_NAME=andrea_savall
DB_USER=tu_usuario_mysql
DB_PASS=tu_password_mysql

# Email de Andrea — solo usado server-side, nunca impreso en el HTML.
ANDREA_EMAIL=contacto@andreasavall.com
ANDREA_PHONE=+34600000000

SITE_URL=https://andreasavall.com
DEFAULT_LOCALE=es
